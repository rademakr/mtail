# sample .mtailrc
files: stdin /stdout\.log/
   filters:
      /continuum/c0nTiNuUm/
   colors:
      /^.*$/             blue
      /^[a-z]+:([^:]+):/ brightblue
      /(warn:)/          red
      /(info:)/          green
      /(debug:)/         brightblack
      /^error.*/         brightred
      /FAILED/         brightred
      /^(error).*/       brightredblink
####
files: /mail\.log/
    colors:
        /stat=Sent/            brightgreen
files: /ldap\.log/
    colors:
        /slapd starting/      reverse_rb
      /nentries=0/            brightyellow
      /err=49/                brightgreen
      /undefined/             brightred
      /\(\|\(uid=.*\)\(sourceid=.*\)\(mail=.*\)\)/             brightgreen
      /\(\&\(objectClass=.*\)\(uid=.*\)\)/             brightyellow
      /QUERY NOT CACHEABLE/             brightred
      /QUERY NOT ANSWERABLE/             brightred
files: /atos-sva-smtp-entrant\.log/
        colors:
      /delay=/         brightcyan
      /linedata/         brightyellow
# fallback for `mtail -u UNIT` / `mtail -j` journal sources that don't
# match a more specific files: block above (unit names are matched
# against files: regexes the same way file basenames are, so a block
# like "files: /sshd/" would already catch "-u sshd" without needing
# this at all -- this is just the catch-all).
files: journal
   colors:
      /FAILED/           brightred
      /^.*$/             cyan

files: default
   colors:
      /^.*$/             white
      /FAILED/         brightred
